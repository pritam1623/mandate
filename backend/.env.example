# Copy to .env and fill in. Everything except ANTHROPIC_API_KEY is optional:
# without PayPal keys the app runs in mock mode; without Channel3 it uses the demo catalog.

DATABASE_URL=sqlite:///./mandate.db

# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from the same app page (after adding a webhook to <backend>/api/webhooks/paypal)
PAYPAL_WEBHOOK_ID=
CURRENCY=USD

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

CHANNEL3_API_KEY=

FRONTEND_URL=http://localhost:3000
